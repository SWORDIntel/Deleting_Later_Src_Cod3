-- Name obfuscation engine
function Shield.GenerateName(prefix)
	Shield.InstanceCounter = Shield.InstanceCounter + 1
	local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
	local hash = ""
	for i = 1, 12 do
		hash = hash .. chars:sub(math.random(1, #chars), math.random(1, #chars))
	end
	return (prefix or "UNC") .. "_" .. hash .. "_" .. Shield.InstanceCounter
end

function Shield.ObfuscateInstance(inst, prefix)
	if not inst or typeof(inst) ~= "Instance" then return inst end
	local newName = Shield.GenerateName(prefix)
	Shield.ProtectedNames[inst] = newName
	local ok = pcall(function()
		inst.Name = newName
	end)
	return inst
end

-- Hook protection - restore original functions
function Shield.ProtectFunction(funcName, originalFunc)
	if not originalFunc then return end
	Shield.OriginalFunctions[funcName] = originalFunc
end

function Shield.RestoreFunction(funcName)
	local orig = Shield.OriginalFunctions[funcName]
	if orig then
		pcall(function()
			_G[funcName] = orig
		end)
	end
end

-- Smooth teleport with CFrame interpolation
function Shield.SmoothTeleport(part, targetCF, duration)
	if not part or not targetCF then return false end
	duration = duration or 0.5
	local startCF = part.CFrame
	local startTime = tick()
	
	local conn
	conn = RunService.Heartbeat:Connect(function()
		local elapsed = tick() - startTime
		local alpha = math.clamp(elapsed / duration, 0, 1)
		-- Ease out cubic
		alpha = 1 - math.pow(1 - alpha, 3)
		
		local ok = pcall(function()
			part.CFrame = startCF:Lerp(targetCF, alpha)
		end)
		
		if alpha >= 1 or not ok then
			pcall(function() conn:Disconnect() end)
		end
	end)
	
	return true
end

-- Velocity normalization - prevents speed kick
function Shield.NormalizeVelocity(part, maxSpeed)
	if not part then return end
	maxSpeed = maxSpeed or 60
	
	local ok, vel = pcall(function()
		return part.Velocity
	end)
	if not ok or not vel then return end
	
	local speed = vel.Magnitude
	if speed > maxSpeed then
		local normalized = vel.Unit * maxSpeed
		pcall(function()
			part.Velocity = Vector3.new(normalized.X, math.clamp(vel.Y, -30, 50), normalized.Z)
		end)
	end
	
	-- Store history for smooth transitions
	table.insert(Shield.VelocityHistory, 1, vel)
	if #Shield.VelocityHistory > 5 then
		table.remove(Shield.VelocityHistory)
	end
end

-- Remote call throttling - prevents remote spam detection
function Shield.ShouldThrottle(remoteName, cooldown)
	cooldown = cooldown or 0.1
	local now = tick()
	local lastCall = Shield.RemoteDelays[remoteName] or 0
	if now - lastCall < cooldown then
		return true
	end
	Shield.RemoteDelays[remoteName] = now
	return false
end

-- Anti-cheat tick accumulator - limits per-frame calls
function Shield.CanProceed(key, maxPerSecond)
	maxPerSecond = maxPerSecond or 30
	local now = tick()
	local acc = Shield.TickAccumulators[key] or {Count = 0, LastReset = now}
	
	if now - acc.LastReset >= 1 then
		acc.Count = 0
		acc.LastReset = now
	end
	
	acc.Count = acc.Count + 1
	Shield.TickAccumulators[key] = acc
	
	return acc.Count <= maxPerSecond
end

-- Position jitter - adds micro-randomization to prevent exact detection
function Shield.JitterPosition(pos, amount)
	amount = amount or 0.001
	return pos + Vector3.new(
		(math.random() - 0.5) * amount,
		(math.random() - 0.5) * amount,
		(math.random() - 0.5) * amount
	)
end

-- Instance cleanup from getgc() scans
