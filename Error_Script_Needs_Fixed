	local function update()
		enabled = not enabled
		local pos = enabled and UDim2.new(1, -30, 0.5, -14) or UDim2.new(0, 2, 0.5, -14)
		local col = enabled and UI.Theme.Success or UI.Theme.Error

		TweenService:Create(circle, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
			Position = pos
		}):Play()
		TweenService:Create(toggleBg, TweenInfo.new(0.35), {BackgroundColor3 = col}):Play()

		if callback then
			callback(enabled)
		end
	end

	frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			update()
		end
	end)

	return frame, function() return enabled end
