	Safe.Call(function()
		for _, part in pairs(Character:GetDescendants()) do
			if part:IsA("BasePart") then
				Safe.Call(function()
					part:SetNetworkOwner(nil)
				end)
			end
		end
	end)

	-- Method 5: State
	if Humanoid then
		Safe.Set(Humanoid, "PlatformStand", true)
		Safe.Set(Humanoid, "HipHeight", 50)
		Safe.Set(Humanoid, "AutoRotate", false)
	end

	-- Method 6: Render (Transparency)
	Safe.Call(function()
		for _, part in pairs(Character:GetDescendants()) do
			if part:IsA("BasePart") then
				Safe.Set(part, "LocalTransparencyModifier", 0.15)
			end
		end
