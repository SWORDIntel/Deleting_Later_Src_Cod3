function UI.SetupDrag()
	local bar = UI.Main:FindFirstChildWhichIsA("Frame")
	if not bar then return end

	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			UI.Dragging = true
			UI.DragStart = input.Position
			UI.StartPos = UI.Main.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if UI.Dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - UI.DragStart
			UI.Main.Position = UDim2.new(
				UI.StartPos.X.Scale, UI.StartPos.X.Offset + delta.X,
				UI.StartPos.Y.Scale, UI.StartPos.Y.Offset + delta.Y
			)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			UI.Dragging = false
		end
	end)
end

function UI.SetupResize()
	local handle = Instance.new("TextButton")
	handle.Name = Shield.GenerateName("Resize")
	handle.Size = UDim2.new(0, 26, 0, 26)
	handle.Position = UDim2.new(1, -26, 1, -26)
	handle.BackgroundTransparency = 1
	handle.Text = "+"
	handle.TextColor3 = UI.Theme.Dim
	handle.TextSize = 16
	handle.Font = Enum.Font.GothamBold
	handle.Parent = UI.Main

	local resizing = false
	local startSize = nil
	local startPos = nil

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			resizing = true
			startSize = UI.Main.Size
			startPos = input.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if resizing and input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - startPos
			local newWidth = math.clamp(startSize.X.Offset + delta.X, 500, 1200)
			local newHeight = math.clamp(startSize.Y.Offset + delta.Y, 350, 800)
			UI.Main.Size = UDim2.new(0, newWidth, 0, newHeight)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			resizing = false
		end
	end)
end

function UI.Hide()
	UI.Visible = false
	TweenService:Create(UI.Main, TweenInfo.new(0.35, Enum.EasingStyle.Quart), {
		Size = UDim2.new(0, 0, 0, 0),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		BackgroundTransparency = 1
	}):Play()
	task.delay(0.35, function()
		UI.Main.Visible = false
	end)
end

