		Noclip.FlyMode = true
		Safe.Notify("FLY", "Active " .. duration .. "s! WASD + Space/Shift", 3, "success")

		task.delay(duration, function()
			Safe.Call(function()
				if HRP then
					for _, child in pairs(HRP:GetChildren()) do
						if child.Name:match("^UNC_FLY") or Shield.ProtectedNames[child] then
							child:Destroy()
						end
					end
				end
			end)
			Noclip.FlyBodyVelocity = nil
			Noclip.FlyBodyGyro = nil
			Noclip.FlyMode = false
			Safe.Notify("FLY", "Ended", 2, "info")
		end)
