function Steal.ScanRemotes()
	Steal.Remotes = {}

	local function scanFolder(folder)
		if not folder then return end
		for _, obj in ipairs(folder:GetDescendants()) do
			if obj and (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")) then
				local name = obj.Name:lower()
				local detected = false
				local score = 0
				for _, pattern in ipairs(Steal.Patterns) do
					if name:find(pattern) then
						detected = true
						score = score + 10
					end
				end
				if name:find("server") or name:find("request") or name:find("action") or name:find("event") then
					score = score + 5
				end
				if name:find("brainrot") or name:find("pet") or name:find("item") or name:find("loot") then
					score = score + 25
				end
				table.insert(Steal.Remotes, {
					Remote = obj,
					Detected = detected,
					Name = obj.Name,
					Score = score,
					Type = obj:IsA("RemoteEvent") and "Event" or "Function",
					LastUsed = 0,
					SuccessRate = 50
				})
			end
		end
	end

	scanFolder(ReplicatedStorage)
	scanFolder(Workspace)

	table.sort(Steal.Remotes, function(a, b)
		return a.Score > b.Score
	end)

	Safe.Notify("STEAL", #Steal.Remotes .. " remotes scanned", 3, "success")
	return Steal.Remotes
end

function Steal.FindBaseSafeZone()
	if Base.MyBase and Base.MyBase.Plot then
		local plot = Base.MyBase.Plot
		local part = plot:FindFirstChildWhichIsA("BasePart")
		if part then
			Steal.BaseSafeZone = part.Position + Vector3.new(0, 10, 0)
			return Steal.BaseSafeZone
		end
	end

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj and obj:IsA("BasePart") then
			local name = obj.Name:lower()
			if name:find("safe") or name:find("spawn") or name:find("home") or name:find("base") then
				local color = obj.Color
				if color.G > 0.5 and color.R < 0.5 then
					Steal.BaseSafeZone = obj.Position + Vector3.new(0, 5, 0)
					return Steal.BaseSafeZone
				end
			end
		end
	end

	return nil
end

function Steal.TeleportToBase()
	if not Steal.AutoTeleportBase then return false end

	local safeZone = Steal.BaseSafeZone or Steal.FindBaseSafeZone()
	if not safeZone then
		if Base.MyBase then
			Base.TeleportTo(Base.MyBase, 10)
			return true
		end
		return false
	end

	Noclip.Enable()
	task.wait(0.2)
	CharMgr.TweenTo(safeZone, 0.4)
	task.wait(0.5)
	Noclip.Disable()

	Safe.Notify("BASE", "Teleported to safe zone!", 2, "success")
	return true
end

function Steal.TrySteal(target)
	if not target or not target.Plot then
		return false
	end

	local now = tick()
	if now - Steal.LastSteal < Steal.Cooldown then
		return false
	end
	Steal.LastSteal = now

	-- Shield: throttle remote calls
	if Shield.ShouldThrottle("TrySteal", 0.5) then
		return false
	end

	local ok = false
	local stolenAmount = 0
	local brainrotsStolen = 0

	-- Pre-teleport to target
	Base.TeleportTo(target, 12)
	task.wait(0.5)

	-- Method 1: Remote exploit (sorted by score)
	for _, info in ipairs(Steal.Remotes) do
		if info.Detected and info.Score >= 10 then
			local remote = info.Remote
			if remote and remote.Parent then
				local args = {target.Plot, LP, target.Value, target.OwnerId}

				if target.Brainrots and #target.Brainrots > 0 then
					for _, br in ipairs(target.Brainrots) do
						table.insert(args, br.Object)
						table.insert(args, br.Name)
					end
				end

				if remote:IsA("RemoteEvent") then
					for attempt = 1, Steal.MaxRetries do
						-- Shield: throttle each remote call
						if not Shield.ShouldThrottle(info.Name, 0.1) then
							local result = Safe.Call(function(...)
								remote:FireServer(...)
								return true
							end, unpack(args))
							if result then
								ok = true
								info.LastUsed = tick()
								info.SuccessRate = math.min(100, info.SuccessRate + 5)
								break
							else
								info.SuccessRate = math.max(0, info.SuccessRate - 10)
								task.wait(0.1)
							end
						end
					end
				elseif remote:IsA("RemoteFunction") then
					if not Shield.ShouldThrottle(info.Name, 0.2) then
						local result = Safe.Call(function(...)
							return remote:InvokeServer(...)
						end, unpack(args))
						if result ~= nil then
							ok = true
							info.LastUsed = tick()
						end
					end
				end
				if ok then break end
			end
		end
	end

	-- Method 2: Direct value transfer
	if not ok then
		for _, child in ipairs(target.Plot:GetDescendants()) do
			if child then
				if child:IsA("IntValue") or child:IsA("NumberValue") then
					local cname = child.Name:lower()
					if cname:find("cash") or cname:find("money") or cname:find("balance") or cname:find("value") then
						local amount = child.Value
						if amount > 0 then
							Safe.Set(child, "Value", 0)
							stolenAmount = stolenAmount + amount

							local stats = LP:FindFirstChild("leaderstats")
							if stats then
								local cash = stats:FindFirstChild("Cash") or stats:FindFirstChild("Money") or stats:FindFirstChild("Coins")
								if cash and (cash:IsA("IntValue") or cash:IsA("NumberValue")) then
									Safe.Set(cash, "Value", cash.Value + amount)
									ok = true
								end
							end

							local pStats = LP:FindFirstChild("Stats") or LP:FindFirstChild("Data") or LP:FindFirstChild("PlayerData")
							if pStats then
								local pCash = pStats:FindFirstChild("Cash") or pStats:FindFirstChild("Money") or pStats:FindFirstChild("Coins")
								if pCash and (pCash:IsA("IntValue") or pCash:IsA("NumberValue")) then
									Safe.Set(pCash, "Value", pCash.Value + amount)
									ok = true
								end
							end
						end
					end
				end
			end
		end
	end

	-- Method 3: Touch collect
	if not ok then
		local hrp = HRP
		if hrp then
			for _, child in ipairs(target.Plot:GetDescendants()) do
				if child and child:IsA("BasePart") then
					local dist = Safe.Call(function()
						return (hrp.Position - child.Position).Magnitude
					end)
					if dist and dist < 30 then
						Safe.Call(function()
							firetouchinterest(hrp, child, 0)
							task.wait(0.05)
							firetouchinterest(hrp, child, 1)
							ok = true
						end)
					end
				end
			end
		end
	end

	-- Method 4: ProximityPrompt
	if not ok then
		for _, child in ipairs(target.Plot:GetDescendants()) do
			if child and child:IsA("ProximityPrompt") then
				local parent = child.Parent
				if parent and parent:IsA("BasePart") then
					local dist = Safe.Call(function()
						if HRP then
							return (HRP.Position - parent.Position).Magnitude
						end
						return math.huge
					end)
					if dist and dist < (child.MaxActivationDistance or 10) then
						Safe.Call(function()
							fireproximityprompt(child)
							ok = true
						end)
					end
				end
			end
		end
	end

	-- Method 5: Brainrot-specific grab
	if Steal.BrainrotMode and not ok then
		for _, br in ipairs(target.Brainrots) do
			if br.Object and br.Position then
				Safe.Call(function()
					CharMgr.MoveTo(br.Position + Vector3.new(0, 5, 0))
					task.wait(0.2)
					if br.Object:IsA("BasePart") and HRP then
						firetouchinterest(HRP, br.Object, 0)
						task.wait(0.1)
						firetouchinterest(HRP, br.Object, 1)
					end
					ok = true
					brainrotsStolen = brainrotsStolen + 1
				end)
			end
		end
	end

	-- Method 6: ClickDetector
	if not ok then
		for _, child in ipairs(target.Plot:GetDescendants()) do
			if child and child:IsA("ClickDetector") then
				local parent = child.Parent
				if parent and parent:IsA("BasePart") and HRP then
					local dist = (HRP.Position - parent.Position).Magnitude
					if dist < (child.MaxActivationDistance or 32) then
						Safe.Call(function()
							fireclickdetector(child)
							ok = true
						end)
					end
				end
			end
		end
	end

	if ok then
		Steal.Success = Steal.Success + 1
		Steal.Stats.TotalStolen = Steal.Stats.TotalStolen + stolenAmount
		Steal.Stats.BrainrotsStolen = Steal.Stats.BrainrotsStolen + brainrotsStolen
		if not Steal.Stats.BestTarget or stolenAmount > (Steal.Stats.BestTarget.Amount or 0) then
			Steal.Stats.BestTarget = {
				Name = target.OwnerName,
				Amount = stolenAmount,
				Brainrots = brainrotsStolen
			}
		end
		Safe.Notify("STEAL", "SUCCESS! " .. target.OwnerName .. " | +$" .. stolenAmount .. " | " .. brainrotsStolen .. " brainrot", 3, "success")

		if Steal.AutoReturn then
			task.delay(Steal.ReturnDelay, function()
				Steal.TeleportToBase()
			end)
		end
	else
		Steal.Fail = Steal.Fail + 1
		if Steal.Mode ~= "Silent" then
			Safe.Notify("STEAL", "Failed | " .. target.OwnerName, 2, "error")
		end
	end

	return ok
end

function Steal.MassSteal()
	local stolenCount = 0
	local totalAmount = 0
	local totalBrainrots = 0
	for _, target in ipairs(Base.List) do
		if not target.IsMine and not target.IsLocked and target.Value > 0 then
			Base.SmartTeleport(target)
			task.wait(1)
			if Steal.TrySteal(target) then
				stolenCount = stolenCount + 1
				totalAmount = totalAmount + target.Value
				totalBrainrots = totalBrainrots + target.BrainrotCount
			end
			task.wait(0.5)
		end
	end

	if Steal.AutoReturn then
		task.delay(1, function()
			Steal.TeleportToBase()
		end)
	end

	Safe.Notify("MASS STEAL", stolenCount .. " targets | $" .. totalAmount .. " | " .. totalBrainrots .. " brainrot", 4, "success")
end

function Steal.AutoLoop()
	if Steal.Active and not Steal._loopRunning then
		Steal._loopRunning = true
		task.spawn(function()
			while Steal.Active do
				task.wait(Steal.Cooldown + 1)
				if not Steal.Active then break end

				local target = nil
				if Steal.BrainrotMode then
					target = Base.GetBestBrainrotTarget() or Base.GetBestTarget()
				else
					target = Base.GetBestTarget()
				end

				if target then
					if Steal.SmartEvade and target.ThreatLevel == "Extreme" then
						Safe.Notify("STEAL", "Skipping extreme threat: " .. target.OwnerName, 2, "warning")
					else
						Base.TeleportTo(target, 20)
						task.wait(0.6)
						Steal.TrySteal(target)
						task.wait(0.5)

						if Steal.AutoReturn then
							task.wait(Steal.ReturnDelay)
							Steal.TeleportToBase()
						end
					end
				end
			end
			Steal._loopRunning = false
		end)
	end
end

function Steal.SetMode(mode)
	Steal.Mode = mode
	if mode == "Aggressive" then
		Steal.Cooldown = 0.5
		Steal.AutoReturn = true
		Steal.SmartEvade = false
	elseif mode == "Nuclear" then
		Steal.Cooldown = 0.1
		Steal.AutoReturn = true
		Steal.BrainrotMode = true
		Steal.SmartEvade = false
	elseif mode == "Silent" then
		Steal.Cooldown = 5
		Steal.AutoReturn = false
		Steal.SmartEvade = true
	elseif mode == "Ghost" then
		Steal.Cooldown = 3
		Steal.AutoReturn = true
		Steal.SmartEvade = true
	else
		Steal.Cooldown = 1.5
		Steal.AutoReturn = true
		Steal.SmartEvade = true
	end
	Safe.Notify("STEAL", "Mode: " .. mode .. " | AutoReturn: " .. tostring(Steal.AutoReturn), 2, "info")
end

