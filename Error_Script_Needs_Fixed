-- QUANTUM PLAYER LIST & TRACKER v4 (Live Stats + Distance + Health + Shielded)
-- ═══════════════════════════════════════════════════════════════════════════════

local PlayerList = {}
PlayerList.Data = {}
PlayerList.MaxPlayers = 50

function PlayerList.Scan()
	PlayerList.Data = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LP then
			local entry = {
				Name = player.Name,
				DisplayName = player.DisplayName,
				UserId = player.UserId,
				Team = player.Team and player.Team.Name or "None",
				Health = 100,
				MaxHealth = 100,
				Distance = 0,
				Position = nil,
				IsAdmin = false,
				IsFriend = false
			}

			if player.Character then
				local hum = player.Character:FindFirstChildOfClass("Humanoid")
				if hum then
					entry.Health = hum.Health
					entry.MaxHealth = hum.MaxHealth
				end
				local hrp = player.Character:FindFirstChild("HumanoidRootPart")
				if hrp then
					entry.Position = hrp.Position
					local myPos = CharMgr.GetPos()
					if myPos then
						entry.Distance = (hrp.Position - myPos).Magnitude
					end
				end
			end

			table.insert(PlayerList.Data, entry)
		end
	end

	table.sort(PlayerList.Data, function(a, b)
		return a.Distance < b.Distance
	end)

	return PlayerList.Data
end

