			Safe.Set(part, "CollisionGroup", props.CollisionGroup)
			Safe.Set(part, "CollisionGroupId", props.CollisionGroupId)
			Safe.Set(part, "Massless", props.Massless)
			Safe.Set(part, "LocalTransparencyModifier", props.LocalTransparencyModifier)
