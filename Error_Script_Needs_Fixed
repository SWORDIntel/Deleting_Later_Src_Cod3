function Steal.TrySteal(target)
	if not target or not target.Plot then
		return false
	end

	local now = tick()
	if now - Steal.LastSteal < Steal.Cooldown then
		return false
	end
	Steal.LastSteal = now

	-- Shield: throttle remote calls
	if Shield.ShouldThrottle("TrySteal", 0.5) then
		return false
	end

	local ok = false
	local stolenAmount = 0
	local brainrotsStolen = 0

	-- Pre-teleport to target
	Base.TeleportTo(target, 12)
	task.wait(0.5)

	-- Method 1: Remote exploit (sorted by score)
	for _, info in ipairs(Steal.Remotes) do
		if info.Detected and info.Score >= 10 then
			local remote = info.Remote
