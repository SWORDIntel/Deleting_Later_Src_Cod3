				Size = part.Size,
				Anchored = part.Anchored,
				CustomPhysicalProperties = part.CustomPhysicalProperties,
				RootPriority = part.RootPriority
			}
		end
	end
end

function Noclip.Enable()
	if Noclip.Active then
		return true
	end
	-- Shield: Check if anti-cheat might be scanning
	if Shield.ShouldThrottle("NoclipEnable", 0.5) then
		task.wait(math.random(1, 5) / 10)
	end
	if not CharMgr.IsReady() then
		Safe.Notify("ERROR", "Character not ready! Waiting...", 3, "error")
		for i = 1, 20 do
			task.wait(0.2)
			CharMgr.Refresh()
			if CharMgr.IsReady() then
				break
			end
		end
		if not CharMgr.IsReady() then
			return false
		end
	end

	Noclip.Active = true
	Noclip.CacheOriginals()
	Noclip.LastPosition = HRP and HRP.Position

	-- Method 1: Property (Stepped loop) - PRIMARY
	Noclip.Conns.Property = RunService.Stepped:Connect(function()
		if not Noclip.Active or not CharMgr.IsReady() then
			return
		end
		-- Shield: throttle noclip updates
		if Shield.CanProceed("NoclipStepped", 60) then
			for _, part in pairs(Character:GetDescendants()) do
				if part:IsA("BasePart") then
					Safe.Set(part, "CanCollide", false)
					Safe.Set(part, "CanTouch", false)
					Safe.Set(part, "CanQuery", false)
				end
			end
		end
	end)

	-- Method 2: CollisionGroup
	Safe.Call(function()
		for _, part in pairs(Character:GetDescendants()) do
			if part:IsA("BasePart") then
				Safe.Set(part, "CollisionGroup", "UNC_NoclipGroup")
