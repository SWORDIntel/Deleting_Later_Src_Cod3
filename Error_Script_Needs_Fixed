function UI.Notify(text, ntype)
	ntype = ntype or "info"
	local colors = {
		success = UI.Theme.Success,
		error = UI.Theme.Error,
		warning = UI.Theme.Warning,
		info = UI.Theme.Info
	}
	local color = colors[ntype] or colors.info
	local icon = ntype == "success" and "+" or ntype == "error" and "x" or
				 ntype == "warning" and "!" or "i"

	while #UI.Notifications >= UI.MaxNotifications do
		local old = table.remove(UI.Notifications, 1)
		if old and old.Frame then
			Safe.Destroy(old.Frame)
		end
	end

	local notif = Instance.new("Frame")
	notif.Name = Shield.GenerateName("Notif")
	notif.Size = UDim2.new(0, 0, 0, 80)
	notif.BackgroundColor3 = UI.Theme.Surface
