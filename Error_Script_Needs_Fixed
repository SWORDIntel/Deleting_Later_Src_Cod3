-- ═══════════════════════════════════════════════════════════════════════════════
-- QUANTUM SAFE CORE v6 (Zero Error Immortal Wrapper + Shield Integration)
-- ═══════════════════════════════════════════════════════════════════════════════

local Safe = {}
Safe.ErrorCount = 0
Safe.MaxErrors = 9999999
Safe.Logs = {}
Safe.MaxLogs = 200
Safe.LastErrorTime = 0
Safe.ErrorCooldown = 0.05
Safe.Connections = {}
Safe.Instances = {}
Safe.NilCache = {}

function Safe.Log(level, msg)
	if not msg then return end
	if #Safe.Logs >= Safe.MaxLogs then
		table.remove(Safe.Logs, 1)
	end
	table.insert(Safe.Logs, {
		Time = os.date("%H:%M:%S"),
		Level = level or "INFO",
		Message = tostring(msg):sub(1, 500)
	})
end

function Safe.Call(func, ...)
	if type(func) ~= "function" then
		Safe.Log("WARN", "Safe.Call received non-function")
		return nil
	end
	if Safe.ErrorCount >= Safe.MaxErrors then
		Safe.Log("FATAL", "Error limit reached!")
		return nil
	end
	local args = {...}
	local nargs = select("#", ...)
	local ok, result = pcall(function()
		if nargs == 0 then
			return func()
		elseif nargs == 1 then
			return func(args[1])
		elseif nargs == 2 then
			return func(args[1], args[2])
		elseif nargs == 3 then
			return func(args[1], args[2], args[3])
		elseif nargs == 4 then
			return func(args[1], args[2], args[3], args[4])
		elseif nargs == 5 then
			return func(args[1], args[2], args[3], args[4], args[5])
		else
			return func(unpack(args, 1, nargs))
		end
	end)
	if not ok then
		local now = tick()
		if now - Safe.LastErrorTime > Safe.ErrorCooldown then
			Safe.ErrorCount = Safe.ErrorCount + 1
			Safe.LastErrorTime = now
		end
		Safe.Log("ERROR", tostring(result):sub(1, 200))
		if DEBUG then
			warn("[UNC7775] " .. tostring(result):sub(1, 300))
		end
		return nil
	end
	return result
end

function Safe.CallRetry(func, retries, delay, ...)
	retries = retries or 3
	delay = delay or 0.1
	local args = {...}
	local nargs = select("#", ...)
	for i = 1, retries do
		local result = Safe.Call(function(...)
			return func(...)
		end, unpack(args, 1, nargs))
		if result ~= nil then
			return result
		end
		if i < retries then
			task.wait(delay)
		end
	end
	return nil
end

function Safe.Connect(signal, callback)
	if not signal or typeof(signal) ~= "RBXScriptSignal" then
		Safe.Log("WARN", "Invalid signal in Safe.Connect")
		return nil
	end
	local conn = Safe.Call(function()
		return signal:Connect(callback)
	end)
	if conn then
		table.insert(Safe.Connections, conn)
	end
	return conn
end

function Safe.DisconnectAll()
	for _, conn in ipairs(Safe.Connections) do
		Safe.Call(function()
			if conn and conn.Connected then
				conn:Disconnect()
			end
		end)
	end
	Safe.Connections = {}
end

function Safe.Wait(parent, name, timeout)
	if not parent or typeof(parent) ~= "Instance" then
		return nil
	end
	timeout = timeout or 5
	local start = tick()
	while tick() - start < timeout do
		local child = parent:FindFirstChild(name)
		if child then
			return child
		end
		task.wait(0.03)
	end
	return nil
end

function Safe.WaitPath(root, path, timeout)
	if not root or typeof(root) ~= "Instance" then return nil end
	if not path or type(path) ~= "string" then return nil end
	timeout = timeout or 5
	local current = root
	local segments = {}
	for segment in string.gmatch(path, "[^%.]+") do
		table.insert(segments, segment)
	end
	local start = tick()
	for _, seg in ipairs(segments) do
		local found = false
		while tick() - start < timeout do
			local child = current:FindFirstChild(seg)
			if child then
				current = child
				found = true
				break
			end
			task.wait(0.03)
		end
		if not found then
			return nil
		end
	end
	return current
end

function Safe.Set(obj, prop, val)
	if not obj or typeof(obj) ~= "Instance" then
		return false
	end
	return Safe.Call(function()
		obj[prop] = val
		return true
	end) == true
end

function Safe.Get(obj, prop)
	if not obj or typeof(obj) ~= "Instance" then
		return nil
	end
	return Safe.Call(function()
		return obj[prop]
	end)
end

function Safe.Invoke(obj, method, ...)
	if not obj or typeof(obj) ~= "Instance" then return nil end
	local args = {...}
	local nargs = select("#", ...)
	return Safe.Call(function(...)
		return obj[method](obj, ...)
	end, unpack(args, 1, nargs))
end

function Safe.Notify(title, text, duration, ntype)
	duration = duration or 3
	ntype = ntype or "info"
	Safe.Log("NOTIFY", (title or "") .. " | " .. (text or ""))
	Safe.Call(function()
		StarterGui:SetCore("SendNotification", {
			Title = title or "UNC 7775",
			Text = text or "",
			Duration = duration,
			Icon = ntype == "success" and "rbxassetid://6031071050" or
				   ntype == "error" and "rbxassetid://6031071057" or
				   ntype == "warning" and "rbxassetid://6031071063" or "rbxassetid://6031071050"
		})
	end)
end

function Safe.Destroy(instance)
	if instance and typeof(instance) == "Instance" then
		Safe.Call(function()
			instance:Destroy()
		end)
	end
end

function Safe.Clone(template)
	if not template or typeof(template) ~= "Instance" then
		return nil
	end
	return Safe.Call(function()
		return template:Clone()
	end)
end

function Safe.IsValid(obj)
	if not obj then return false end
	if typeof(obj) ~= "Instance" then return false end
	return Safe.Call(function()
		return obj.Parent ~= nil
	end) == true
end

function Safe.Distance(pos1, pos2)
	if not pos1 or not pos2 then return math.huge end
	return Safe.Call(function()
		return (pos1 - pos2).Magnitude
	end) or math.huge
end

function Safe.RandomString(length)
	length = length or 8
	local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
	local result = ""
	for i = 1, length do
		local idx = math.random(1, #chars)
		result = result .. chars:sub(idx, idx)
	end
	return result
end

function Safe.NilCheck(obj, timeout)
	timeout = timeout or 5
	local start = tick()
	while tick() - start < timeout do
		if obj ~= nil then
			return obj
		end
		task.wait(0.05)
	end
	return nil
end

-- ═══════════════════════════════════════════════════════════════════════════════
-- QUANTUM CHARACTER MANAGER v8 (Atomic State + Anti-Ragdoll + Physics + Shielded)
-- ═══════════════════════════════════════════════════════════════════════════════

local CharMgr = {}
CharMgr.LastRefresh = 0
CharMgr.RefreshCooldown = 0.05
CharMgr.AntiRagdollConn = nil
CharMgr.StateSpoofConn = nil
CharMgr.Connections = {}
CharMgr.Stats = {Refreshes = 0, RagdollBlocks = 0}
CharMgr.OriginalProps = {}
CharMgr.ShieldConns = {}

function CharMgr.Refresh()
	local now = tick()
	if now - CharMgr.LastRefresh < CharMgr.RefreshCooldown then
		return HRP ~= nil
	end
	CharMgr.LastRefresh = now
	CharMgr.Stats.Refreshes = CharMgr.Stats.Refreshes + 1

	if LP then
		Character = LP.Character
	end
	if not Character then
		return false
	end

	Humanoid = Safe.Wait(Character, "Humanoid", 2)
	HRP = Safe.Wait(Character, "HumanoidRootPart", 2)

	if not HRP or not Humanoid then
		for _, part in pairs(Character:GetDescendants()) do
			if part:IsA("BasePart") then
				local name = part.Name:lower()
				if not HRP and (name:find("torso") or name:find("root") or name:find("upper")) then
					HRP = part
				end
			end
		end
	end

	if Humanoid and not CharMgr.OriginalProps.HipHeight then
		CharMgr.OriginalProps.HipHeight = Humanoid.HipHeight
		CharMgr.OriginalProps.WalkSpeed = Humanoid.WalkSpeed
		CharMgr.OriginalProps.JumpPower = Humanoid.JumpPower
		CharMgr.OriginalProps.JumpHeight = Humanoid.JumpHeight
	end

	return HRP ~= nil and Humanoid ~= nil
end

function CharMgr.IsReady()
	return HRP ~= nil and Humanoid ~= nil and Character ~= nil and Safe.IsValid(Character) and Safe.IsValid(HRP) and Safe.IsValid(Humanoid)
end

function CharMgr.WaitReady(timeout)
	timeout = timeout or 10
	local start = tick()
	while tick() - start < timeout do
		if CharMgr.IsReady() then
			return true
		end
		CharMgr.Refresh()
		task.wait(0.1)
	end
	return false
end

function CharMgr.GetPos()
	if not CharMgr.IsReady() then
		CharMgr.Refresh()
	end
	if not HRP then
		return nil
	end
	return Safe.Get(HRP, "Position")
end

function CharMgr.GetCFrame()
	if not CharMgr.IsReady() then
		CharMgr.Refresh()
	end
	if not HRP then
		return nil
	end
	return Safe.Get(HRP, "CFrame")
end

function CharMgr.MoveTo(pos)
	if not HRP or not pos then
		return false
	end
	-- Shield integration: smooth teleport instead of instant
	if typeof(pos) == "CFrame" then
		return Shield.SmoothTeleport(HRP, pos, 0.15)
	elseif typeof(pos) == "Vector3" then
		return Shield.SmoothTeleport(HRP, CFrame.new(pos), 0.15)
	end
	return false
end

function CharMgr.TweenTo(pos, duration)
	if not HRP or not pos then return false end
	duration = duration or 0.3
	local targetCF = typeof(pos) == "CFrame" and pos or CFrame.new(pos)
	
	-- Shield: use smooth teleport instead of tween for anti-cheat
	return Shield.SmoothTeleport(HRP, targetCF, duration)
end

function CharMgr.PathfindTo(targetPos)
	if not CharMgr.IsReady() or not targetPos then return false end

	return Safe.Call(function()
		local path = PathfindingService:CreatePath({
			AgentRadius = 2,
			AgentHeight = 5,
			AgentCanJump = true,
			AgentJumpDistance = 10,
			AgentMaxSlope = 45,
			AgentMaxJumpHeight = 10,
			Costs = {
				Water = math.huge,
				Danger = math.huge
			}
		})

		local success = pcall(function()
			path:ComputeAsync(HRP.Position, targetPos)
		end)

		if not success or path.Status ~= Enum.PathStatus.Success then
			return false
		end

		local waypoints = path:GetWaypoints()
		for _, waypoint in ipairs(waypoints) do
			if waypoint.Action == Enum.PathWaypointAction.Jump then
				Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
			end
			Humanoid:MoveTo(waypoint.Position)
			local finished = Humanoid.MoveToFinished:Wait()
			if not finished then
				return false
			end
		end
		return true
	end) == true
end

function CharMgr.SmartMoveTo(targetPos, usePathfinding)
	if not targetPos then return false end
	local myPos = CharMgr.GetPos()
	if not myPos then return false end

	local dist = (targetPos - myPos).Magnitude
	if dist > 500 then
		return CharMgr.MoveTo(targetPos + Vector3.new(0, 15, 0))
	elseif usePathfinding and dist > 50 then
		local ok = CharMgr.PathfindTo(targetPos)
		if ok then return true end
		return CharMgr.TweenTo(targetPos, 0.5)
	else
		return CharMgr.TweenTo(targetPos, 0.3)
	end
end

function CharMgr.SetWalkSpeed(speed)
	if Humanoid then
		-- Shield: throttle speed changes
		if Shield.CanProceed("SetWalkSpeed", 20) then
			Safe.Set(Humanoid, "WalkSpeed", speed)
		end
	end
end

function CharMgr.SetJumpPower(power)
	if Humanoid then
		Safe.Set(Humanoid, "JumpPower", power)
	end
end

function CharMgr.SetJumpHeight(height)
	if Humanoid then
		Safe.Set(Humanoid, "JumpHeight", height)
	end
end

function CharMgr.SetHipHeight(height)
	if Humanoid then
		Safe.Set(Humanoid, "HipHeight", height)
	end
end

function CharMgr.SetGravityScale(scale)
	if Humanoid then
		Safe.Set(Humanoid, "GravityScale", scale)
	end
end

function CharMgr.GetHealth()
	if Humanoid then
		return Safe.Get(Humanoid, "Health") or 0
	end
	return 0
end

function CharMgr.GetMaxHealth()
	if Humanoid then
		return Safe.Get(Humanoid, "MaxHealth") or 100
	end
	return 100
end

function CharMgr.GetHealthPercent()
	local maxH = CharMgr.GetMaxHealth()
	if maxH <= 0 then return 0 end
	return CharMgr.GetHealth() / maxH
end

function CharMgr.ResetProperties()
	if Humanoid then
		Safe.Set(Humanoid, "WalkSpeed", CharMgr.OriginalProps.WalkSpeed or 16)
		Safe.Set(Humanoid, "JumpPower", CharMgr.OriginalProps.JumpPower or 50)
		Safe.Set(Humanoid, "JumpHeight", CharMgr.OriginalProps.JumpHeight or 7.2)
		Safe.Set(Humanoid, "HipHeight", CharMgr.OriginalProps.HipHeight or 2)
		Safe.Set(Humanoid, "GravityScale", 1)
		Safe.Set(Humanoid, "PlatformStand", false)
		Safe.Set(Humanoid, "AutoRotate", true)
		Safe.Set(Humanoid, "Sit", false)
	end
end

function CharMgr.EnableAntiRagdoll()
	CharMgr.DisableAntiRagdoll()
	CharMgr.AntiRagdollConn = RunService.Heartbeat:Connect(function()
		if not Humanoid then return end
		Safe.Call(function()
			local state = Humanoid:GetState()
			if state == Enum.HumanoidStateType.Ragdoll or
			   state == Enum.HumanoidStateType.FallingDown or
			   state == Enum.HumanoidStateType.PlatformStanding then
				Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
				task.wait(0.01)
				Humanoid:ChangeState(Enum.HumanoidStateType.Running)
				Humanoid:ChangeState(Enum.HumanoidStateType.None)
				CharMgr.Stats.RagdollBlocks = CharMgr.Stats.RagdollBlocks + 1
			end
			if Humanoid.Sit then
				Humanoid.Sit = false
			end
			if Humanoid.PlatformStand then
				Humanoid.PlatformStand = false
			end
		end)
	end)
end

function CharMgr.DisableAntiRagdoll()
	if CharMgr.AntiRagdollConn then
		Safe.Call(function()
			CharMgr.AntiRagdollConn:Disconnect()
		end)
		CharMgr.AntiRagdollConn = nil
	end
end

function CharMgr.EnableStateSpoof()
	CharMgr.StateSpoofConn = RunService.Heartbeat:Connect(function()
		if not Humanoid then return end
		Safe.Call(function()
			local state = Humanoid:GetState()
			if state == Enum.HumanoidStateType.Ragdoll or
			   state == Enum.HumanoidStateType.FallingDown or
			   state == Enum.HumanoidStateType.PlatformStanding then
				Humanoid:ChangeState(Enum.HumanoidStateType.Running)
				Humanoid:ChangeState(Enum.HumanoidStateType.None)
			end
		end)
	end)
end

function CharMgr.DisableStateSpoof()
	if CharMgr.StateSpoofConn then
		Safe.Call(function()
			CharMgr.StateSpoofConn:Disconnect()
		end)
		CharMgr.StateSpoofConn = nil
	end
end

-- Init
CharMgr.Refresh()
CharMgr.EnableAntiRagdoll()

Safe.Connect(LP.CharacterAdded, function(char)
	task.wait(0.3)
	Character = char
	CharMgr.Refresh()
	CharMgr.EnableAntiRagdoll()
	if Noclip and Noclip.Active then
		task.wait(0.4)
		if Noclip.Enable then
			Noclip.Enable()
		end
	end
	Safe.Notify("CHARACTER", "Character loaded! Anti-ragdoll active.", 2, "info")
end)

Safe.Connect(LP.CharacterRemoving, function()
	Character = nil
	Humanoid = nil
	HRP = nil
	CharMgr.DisableAntiRagdoll()
end)

