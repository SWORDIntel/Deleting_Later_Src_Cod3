function ESP.Add(obj, objType, customData)
	if not obj or ESP.Objects[obj] then return end

	local data = {
		Object = obj,
		Type = objType or "Unknown",
		Color = customData.Color or ESP.Theme.PlayerNeutral,
		Name = customData.Name or obj.Name,
		Info = customData.Info or "",
		Health = customData.Health or 100,
		MaxHealth = customData.MaxHealth or 100,
		RarityIcon = customData.RarityIcon or ""
	}

	local parent = obj
	if obj:IsA("Model") then
		parent = obj:FindFirstChild("Head") or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")
	elseif obj:IsA("Player") then
		local char = obj.Character
		if char then
			parent = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildWhichIsA("BasePart")
		end
	end

	if parent then
		data.Gui = ESP.CreateBillboard(parent, data)
	end

	ESP.Objects[obj] = data
end

function ESP.Remove(obj)
	local data = ESP.Objects[obj]
	if not data then return end
	if data.Gui and data.Gui.Billboard then
		Safe.Destroy(data.Gui.Billboard)
	end
	ESP.Objects[obj] = nil
end

function ESP.Update()
	if not ESP.Active then return end

	local myPos = CharMgr.GetPos()
	if not myPos then return end

	for obj, data in pairs(ESP.Objects) do
		if not obj or not obj.Parent then
			ESP.Remove(obj)
		else
			if data.Gui then
				local pos = nil
				local health = data.Health
				local maxHealth = data.MaxHealth

				if obj:IsA("Model") then
					local part = obj:FindFirstChildWhichIsA("BasePart")
					if part then
						pos = part.Position
					end
					local hum = obj:FindFirstChildOfClass("Humanoid")
					if hum then
						health = hum.Health
						maxHealth = hum.MaxHealth
					end
				elseif obj:IsA("BasePart") then
					pos = obj.Position
				elseif obj:IsA("Player") then
					local char = obj.Character
					if char then
						local part = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
						if part then
							pos = part.Position
						end
						local hum = char:FindFirstChildOfClass("Humanoid")
						if hum then
							health = hum.Health
							maxHealth = hum.MaxHealth
						end
					end
				end

				if not pos then
					data.Gui.Billboard.Enabled = false
				else
					local dist = (myPos - pos).Magnitude
					if dist > ESP.MaxDist then
						data.Gui.Billboard.Enabled = false
					else
						data.Gui.DistLabel.Text = math.floor(dist) .. "m"

						local healthPercent = math.clamp(health / maxHealth, 0, 1)
						data.Gui.HealthFill.Size = UDim2.new(healthPercent, 0, 1, 0)
						data.Gui.HealthFill.BackgroundColor3 = healthPercent > 0.5 and Color3.fromRGB(0, 255, 100) or
																	   healthPercent > 0.25 and Color3.fromRGB(255, 255, 0) or
																					   Color3.fromRGB(255, 0, 0)

						if data.Type == "Player" then
							data.Gui.InfoLabel.Text = string.format("HP: %d/%d", math.floor(health), math.floor(maxHealth))
						elseif data.Type == "Base" then
							local baseData = nil
							for _, b in ipairs(Base.List) do
								if b.Plot == obj then
									baseData = b
									break
								end
							end
							if baseData then
								data.Gui.InfoLabel.Text = string.format("$%d | %d items | %d brainrot | %s",
									baseData.Value, baseData.ItemCount, baseData.BrainrotCount, baseData.ThreatLevel)
								if baseData.IsLocked then
									data.Gui.Stroke.Color = ESP.Theme.BaseLocked
									data.Gui.Glow.BackgroundColor3 = ESP.Theme.BaseLocked
								elseif baseData.IsMine then
									data.Gui.Stroke.Color = ESP.Theme.BaseMine
									data.Gui.Glow.BackgroundColor3 = ESP.Theme.BaseMine
								end
							end
						end

						local scale = math.clamp(1 - (dist / ESP.MaxDist) * 0.5, 0.5, 1)
						data.Gui.Billboard.Size = UDim2.new(0, 240 * scale, 0, 100 * scale)
						data.Gui.Billboard.Enabled = true
					end
				end
			end
		end
	end
