function SpeedMod.Enable(speed)
	if SpeedMod.Active then return end
	SpeedMod.Active = true
	SpeedMod.Speed = speed or 80

	SpeedMod.Conn = RunService.Heartbeat:Connect(function()
		if not SpeedMod.Active or not Humanoid then return end
