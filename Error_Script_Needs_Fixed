function Noclip.CacheOriginals()
	Noclip.Originals = {}
	if not CharMgr.IsReady() then
		return
	end
	for _, part in pairs(Character:GetDescendants()) do
		if part:IsA("BasePart") then
			Noclip.Originals[part] = {
				CanCollide = part.CanCollide,
				CanTouch = part.CanTouch,
				CanQuery = part.CanQuery,
				CollisionGroup = part.CollisionGroup,
				CollisionGroupId = part.CollisionGroupId,
				Massless = part.Massless,
				LocalTransparencyModifier = part.LocalTransparencyModifier,
				Material = part.Material,
				Size = part.Size,
				Anchored = part.Anchored,
				CustomPhysicalProperties = part.CustomPhysicalProperties,
				RootPriority = part.RootPriority
			}
		end
	end
end

function Noclip.Enable()
	if Noclip.Active then
		return true
	end
	if not CharMgr.IsReady() then
		Safe.Notify("ERROR", "Character not ready! Waiting...", 3, "error")
		for i = 1, 20 do
			task.wait(0.2)
			CharMgr.Refresh()
			if CharMgr.IsReady() then
				break
			end
		end
		if not CharMgr.IsReady() then
			return false
		end
	end

	Noclip.Active = true
	Noclip.CacheOriginals()
	Noclip.LastPosition = HRP and HRP.Position

	-- Method 1: Property (Stepped loop) - PRIMARY
	Noclip.Conns.Property = RunService.Stepped:Connect(function()
		if not Noclip.Active or not CharMgr.IsReady() then
			return
		end
		-- Shield: throttle noclip updates
		if Shield.CanProceed("NoclipStepped", 60) then
			for _, part in pairs(Character:GetDescendants()) do
				if part:IsA("BasePart") then
					Safe.Set(part, "CanCollide", false)
					Safe.Set(part, "CanTouch", false)
					Safe.Set(part, "CanQuery", false)
				end
			end
		end
	end)

	-- Method 2: CollisionGroup
	Safe.Call(function()
		for _, part in pairs(Character:GetDescendants()) do
			if part:IsA("BasePart") then
				Safe.Set(part, "CollisionGroup", "UNC_NoclipGroup")
			end
		end
	end)

	-- Method 3: Physics (Low gravity + high speed)
	Safe.Set(Workspace, "Gravity", 10)
	if Humanoid then
		Safe.Set(Humanoid, "WalkSpeed", Noclip.Speed)
		Safe.Set(Humanoid, "JumpPower", 100)
		Safe.Set(Humanoid, "GravityScale", 0.1)
	end

	-- Method 4: Network Ownership
	Safe.Call(function()
		for _, part in pairs(Character:GetDescendants()) do
			if part:IsA("BasePart") then
				Safe.Call(function()
					part:SetNetworkOwner(nil)
				end)
			end
		end
	end)

	-- Method 5: State
	if Humanoid then
		Safe.Set(Humanoid, "PlatformStand", true)
		Safe.Set(Humanoid, "HipHeight", 50)
		Safe.Set(Humanoid, "AutoRotate", false)
	end

	-- Method 6: Render (Transparency)
	Safe.Call(function()
		for _, part in pairs(Character:GetDescendants()) do
			if part:IsA("BasePart") then
				Safe.Set(part, "LocalTransparencyModifier", 0.15)
			end
		end
	end)

	-- Method 7: Velocity (BodyVelocity fallback)
	Safe.Call(function()
		if HRP and not HRP:FindFirstChild("UNC_BV") then
			local bv = Instance.new("BodyVelocity")
			bv.Name = Shield.GenerateName("BV")
			bv.Velocity = Vector3.new(0, 0, 0)
			bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
			bv.P = 1e6
			bv.Parent = HRP
		end
	end)

	-- Method 8: Massless
	Safe.Call(function()
		for _, part in pairs(Character:GetDescendants()) do
			if part:IsA("BasePart") then
				Safe.Set(part, "Massless", true)
			end
		end
	end)

	-- Method 9: Size manipulation (anti-detect)
	Safe.Call(function()
		for _, part in pairs(Character:GetDescendants()) do
			if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
				local orig = Noclip.Originals[part]
				if orig then
					Safe.Set(part, "Size", orig.Size * 0.97)
				end
			end
		end
	end)

	-- Method 10: Anchor spoof
	Safe.Call(function()
		if HRP then
			Safe.Set(HRP, "Anchored", false)
		end
	end)

	-- Method 11: CustomPhysicalProperties (frictionless)
	Safe.Call(function()
		for _, part in pairs(Character:GetDescendants()) do
			if part:IsA("BasePart") then
				Safe.Set(part, "CustomPhysicalProperties", PhysicalProperties.new(0, 0, 0, 0, 0))
			end
		end
	end)

	-- Method 12: Material change (anti-detect)
	Safe.Call(function()
		for _, part in pairs(Character:GetDescendants()) do
			if part:IsA("BasePart") then
				Safe.Set(part, "Material", Enum.Material.ForceField)
			end
		end
	end)

	-- Method 13: BodyPosition stabilization
	Safe.Call(function()
		if HRP and not HRP:FindFirstChild("UNC_BP") then
			local bp = Instance.new("BodyPosition")
			bp.Name = Shield.GenerateName("BP")
			bp.MaxForce = Vector3.new(1e6, 1e6, 1e6)
			bp.P = 1e5
			bp.D = 1e4
			bp.Position = HRP.Position
			bp.Parent = HRP
		end
	end)

	-- Smart Rotation
	if Noclip.SmartRotation then
		Noclip.Conns.Rotate = task.spawn(function()
			while Noclip.Active do
				task.wait(Noclip.RotationInterval)
				if not Noclip.Active then break end
				Noclip.Method = Noclip.Method + 1
				if Noclip.Method > #Noclip.Methods then
					Noclip.Method = 1
				end
				Noclip.Stats.Switches = Noclip.Stats.Switches + 1
				if DEBUG then
					Safe.Notify("NOCLIP", "Method: " .. Noclip.Methods[Noclip.Method], 1, "info")
				end
			end
		end)
	end

	-- Anti-ragdoll + State stabilizer
	Noclip.Conns.AntiRagdoll = RunService.Heartbeat:Connect(function()
		if not Noclip.Active or not Humanoid then return end
		Safe.Call(function()
			local state = Humanoid:GetState()
			if state == Enum.HumanoidStateType.Ragdoll or
			   state == Enum.HumanoidStateType.FallingDown then
				Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
				Humanoid:ChangeState(Enum.HumanoidStateType.Running)
			end
		end)
	end)

	-- Velocity stabilizer + position validation + shield normalization
	Noclip.Conns.Velocity = RunService.Heartbeat:Connect(function()
		if not Noclip.Active or not HRP then return end
		Safe.Call(function()
			local vel = HRP.Velocity
			if vel.Y < -50 then
				HRP.Velocity = Vector3.new(vel.X, 0, vel.Z)
			end
			if Noclip.AntiDetect and Noclip.LastPosition then
				local dist = (HRP.Position - Noclip.LastPosition).Magnitude
				if dist > 50 then
					HRP.Velocity = Vector3.new(0, 0, 0)
				end
			end
			-- Shield: normalize velocity to prevent speed kick
			if Noclip.ShieldMode then
				Shield.NormalizeVelocity(HRP, 55)
			end
			Noclip.LastPosition = HRP.Position
		end)
	end)

	Safe.Notify("NOCLIP", "ACTIVE | Method: " .. Noclip.Methods[Noclip.Method] .. " | Shield: ON", 3, "success")
	return true
end

function Noclip.Disable()
	if not Noclip.Active then return end
	Noclip.Active = false

	for name, conn in pairs(Noclip.Conns) do
		if conn then
			Safe.Call(function()
				if typeof(conn) == "RBXScriptConnection" and conn.Connected then
					conn:Disconnect()
				end
			end)
		end
	end
	Noclip.Conns = {}

	for part, props in pairs(Noclip.Originals) do
		if part and part.Parent then
			Safe.Set(part, "CanCollide", props.CanCollide)
			Safe.Set(part, "CanTouch", props.CanTouch)
			Safe.Set(part, "CanQuery", props.CanQuery)
			Safe.Set(part, "CollisionGroup", props.CollisionGroup)
			Safe.Set(part, "CollisionGroupId", props.CollisionGroupId)
			Safe.Set(part, "Massless", props.Massless)
			Safe.Set(part, "LocalTransparencyModifier", props.LocalTransparencyModifier)
			Safe.Set(part, "Size", props.Size)
			Safe.Set(part, "Anchored", props.Anchored)
			Safe.Set(part, "CustomPhysicalProperties", props.CustomPhysicalProperties)
			Safe.Set(part, "Material", props.Material)
			Safe.Set(part, "RootPriority", props.RootPriority)
		end
	end

	Safe.Call(function()
		if HRP then
			for _, child in pairs(HRP:GetChildren()) do
				if child.Name:match("^UNC_[Bb][Vv]_") or child.Name:match("^UNC_[Bb][Pp]_") then
					child:Destroy()
				end
			end
		end
	end)

	Safe.Set(Workspace, "Gravity", 196.2)

	if Humanoid then
		Safe.Set(Humanoid, "PlatformStand", false)
		Safe.Set(Humanoid, "HipHeight", CharMgr.OriginalProps.HipHeight or 2)
		Safe.Set(Humanoid, "WalkSpeed", CharMgr.OriginalProps.WalkSpeed or 16)
		Safe.Set(Humanoid, "JumpPower", CharMgr.OriginalProps.JumpPower or 50)
		Safe.Set(Humanoid, "JumpHeight", CharMgr.OriginalProps.JumpHeight or 7.2)
		Safe.Set(Humanoid, "AutoRotate", true)
		Safe.Set(Humanoid, "GravityScale", 1)
	end

	Noclip.FlyMode = false
	Safe.Notify("NOCLIP", "Disabled", 2, "info")
end

function Noclip.Toggle()
	if Noclip.Active then
		Noclip.Disable()
	else
		Noclip.Enable()
	end
end

function Noclip.EnableFly(duration)
	duration = duration or 30
	if not HRP then
		Safe.Notify("FLY", "HRP not found!", 2, "error")
		return
	end

	Noclip.Enable()
	task.wait(0.2)

	Safe.Call(function()
		local bv = Instance.new("BodyVelocity")
		bv.Name = Shield.GenerateName("FLY")
		bv.Velocity = Vector3.new(0, 0, 0)
		bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
		bv.P = 1e7
		bv.Parent = HRP
		Noclip.FlyBodyVelocity = bv

		local bg = Instance.new("BodyGyro")
		bg.Name = Shield.GenerateName("FLYG")
		bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
		bg.P = 1e6
		bg.D = 1e3
		bg.CFrame = Camera.CFrame
		bg.Parent = HRP
		Noclip.FlyBodyGyro = bg

		Noclip.FlyMode = true
		Safe.Notify("FLY", "Active " .. duration .. "s! WASD + Space/Shift", 3, "success")

		task.delay(duration, function()
			Safe.Call(function()
				if HRP then
					for _, child in pairs(HRP:GetChildren()) do
						if child.Name:match("^UNC_FLY") or Shield.ProtectedNames[child] then
							child:Destroy()
						end
					end
				end
			end)
			Noclip.FlyBodyVelocity = nil
			Noclip.FlyBodyGyro = nil
			Noclip.FlyMode = false
			Safe.Notify("FLY", "Ended", 2, "info")
		end)
	end)
end

function Noclip.UpdateFly()
	if not Noclip.FlyMode or not Noclip.FlyBodyGyro or not Noclip.FlyBodyVelocity then return end
	Safe.Call(function()
		Noclip.FlyBodyGyro.CFrame = Camera.CFrame
		local moveDir = Vector3.new(0, 0, 0)
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then
			moveDir = moveDir + Camera.CFrame.LookVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then
			moveDir = moveDir - Camera.CFrame.LookVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then
			moveDir = moveDir - Camera.CFrame.RightVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then
			moveDir = moveDir + Camera.CFrame.RightVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			moveDir = moveDir + Vector3.new(0, 1, 0)
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
			moveDir = moveDir - Vector3.new(0, 1, 0)
		end
		if moveDir.Magnitude > 0 then
			moveDir = moveDir.Unit * Noclip.Speed
		end
		Noclip.FlyBodyVelocity.Velocity = moveDir
	end)
end

