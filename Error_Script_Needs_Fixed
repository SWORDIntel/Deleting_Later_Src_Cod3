				local args = {target.Plot, LP, target.Value, target.OwnerId}

				if target.Brainrots and #target.Brainrots > 0 then
					for _, br in ipairs(target.Brainrots) do
						table.insert(args, br.Object)
						table.insert(args, br.Name)
					end
				end

				if remote:IsA("RemoteEvent") then
					for attempt = 1, Steal.MaxRetries do
						-- Shield: throttle each remote call
						if not Shield.ShouldThrottle(info.Name, 0.1) then
							local result = Safe.Call(function(...)
								remote:FireServer(...)
								return true
							end, unpack(args))
							if result then
								ok = true
								info.LastUsed = tick()
								info.SuccessRate = math.min(100, info.SuccessRate + 5)
								break
							else
								info.SuccessRate = math.max(0, info.SuccessRate - 10)
								task.wait(0.1)
							end
						end
					end
				elseif remote:IsA("RemoteFunction") then
					if not Shield.ShouldThrottle(info.Name, 0.2) then
						local result = Safe.Call(function(...)
							return remote:InvokeServer(...)
						end, unpack(args))
						if result ~= nil then
							ok = true
							info.LastUsed = tick()
						end
					end
				end
				if ok then break end
			end
		end
	end

	-- Method 2: Direct value transfer
	if not ok then
