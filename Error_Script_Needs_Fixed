function Auto.SetModule(name, state)
	if Auto.Modules[name] == nil then return end
	Auto.Modules[name] = state
	if state and Auto.Active then
		if name == "Farm" then Auto.StartFarm()
		elseif name == "Collect" then Auto.StartCollect()
		elseif name == "Steal" then Auto.StartSteal()
		elseif name == "Click" then Auto.StartClick()
		elseif name == "Brainrot" then Auto.StartBrainrot()
		end
	end
	Safe.Notify("AUTO", name .. ": " .. (state and "ON" or "OFF"), 2, state and "success" or "info")
end

function Auto.Toggle(state)
	Auto.Active = state
	if state then
		for name, active in pairs(Auto.Modules) do
			if active then
				Auto.SetModule(name, true)
			end
		end
		Safe.Notify("AUTO", "MASTER ON", 3, "success")
	else
		Safe.Notify("AUTO", "MASTER OFF", 2, "info")
	end
end

