-- QUANTUM BASE SCANNER v9 (Deep Intelligence + Brainrot Detection + Predictive)
-- ═══════════════════════════════════════════════════════════════════════════════

local Base = {}
Base.Folder = nil
Base.List = {}
Base.MyBase = nil
Base.Target = nil
Base.Active = false
Base.ScanHistory = {}
Base.MaxHistory = 15
Base.Stats = {Scans = 0, TotalValue = 0}
Base.BrainrotKeywords = {
	"brainrot", "pet", "animal", "creature", "mob", "monster",
	"legendary", "secret", "rare", "epic", "mythic", "divine",
	"omega", "ultra", "exotic", "halloween", "christmas", "event",
	"god", "immortal", "eternal", "cosmic", "celestial"
}
Base.BaseKeywords = {
	"plot", "base", "tycoon", "home", "land", "claim", "island",
	"farm", "shop", "build", "territory", "vault", "storage",
	"locker", "area", "zone", "region", "kingdom", "empire",
	"factory", "business", "company", "corporation", "brainrot"
}
Base.RarityTiers = {
	{Keyword = "secret", Name = "Secret", Value = 100000},
	{Keyword = "divine", Name = "Divine", Value = 50000},
	{Keyword = "cosmic", Name = "Cosmic", Value = 30000},
