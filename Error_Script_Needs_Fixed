					end
				end
			end
		end
	end

	-- Method 4: ProximityPrompt
	if not ok then
		for _, child in ipairs(target.Plot:GetDescendants()) do
			if child and child:IsA("ProximityPrompt") then
				local parent = child.Parent
				if parent and parent:IsA("BasePart") then
					local dist = Safe.Call(function()
						if HRP then
							return (HRP.Position - parent.Position).Magnitude
						end
						return math.huge
					end)
					if dist and dist < (child.MaxActivationDistance or 10) then
						Safe.Call(function()
							fireproximityprompt(child)
							ok = true
						end)
					end
				end
			end
		end
	end

	-- Method 5: Brainrot-specific grab
	if Steal.BrainrotMode and not ok then
		for _, br in ipairs(target.Brainrots) do
			if br.Object and br.Position then
				Safe.Call(function()
					CharMgr.MoveTo(br.Position + Vector3.new(0, 5, 0))
					task.wait(0.2)
					if br.Object:IsA("BasePart") and HRP then
						firetouchinterest(HRP, br.Object, 0)
						task.wait(0.1)
						firetouchinterest(HRP, br.Object, 1)
					end
					ok = true
					brainrotsStolen = brainrotsStolen + 1
				end)
			end
		end
	end

	-- Method 6: ClickDetector
	if not ok then
		for _, child in ipairs(target.Plot:GetDescendants()) do
			if child and child:IsA("ClickDetector") then
				local parent = child.Parent
				if parent and parent:IsA("BasePart") and HRP then
					local dist = (HRP.Position - parent.Position).Magnitude
					if dist < (child.MaxActivationDistance or 32) then
						Safe.Call(function()
							fireclickdetector(child)
							ok = true
						end)
					end
				end
			end
		end
	end

	if ok then
		Steal.Success = Steal.Success + 1
		Steal.Stats.TotalStolen = Steal.Stats.TotalStolen + stolenAmount
		Steal.Stats.BrainrotsStolen = Steal.Stats.BrainrotsStolen + brainrotsStolen
		if not Steal.Stats.BestTarget or stolenAmount > (Steal.Stats.BestTarget.Amount or 0) then
			Steal.Stats.BestTarget = {
				Name = target.OwnerName,
				Amount = stolenAmount,
				Brainrots = brainrotsStolen
			}
		end
		Safe.Notify("STEAL", "SUCCESS! " .. target.OwnerName .. " | +$" .. stolenAmount .. " | " .. brainrotsStolen .. " brainrot", 3, "success")

		if Steal.AutoReturn then
			task.delay(Steal.ReturnDelay, function()
				Steal.TeleportToBase()
			end)
		end
	else
		Steal.Fail = Steal.Fail + 1
		if Steal.Mode ~= "Silent" then
			Safe.Notify("STEAL", "Failed | " .. target.OwnerName, 2, "error")
		end
	end

	return ok
end

function Steal.MassSteal()
	local stolenCount = 0
	local totalAmount = 0
	local totalBrainrots = 0
	for _, target in ipairs(Base.List) do
		if not target.IsMine and not target.IsLocked and target.Value > 0 then
			Base.SmartTeleport(target)
			task.wait(1)
			if Steal.TrySteal(target) then
				stolenCount = stolenCount + 1
				totalAmount = totalAmount + target.Value
				totalBrainrots = totalBrainrots + target.BrainrotCount
			end
			task.wait(0.5)
		end
	end

	if Steal.AutoReturn then
		task.delay(1, function()
			Steal.TeleportToBase()
		end)
	end

	Safe.Notify("MASS STEAL", stolenCount .. " targets | $" .. totalAmount .. " | " .. totalBrainrots .. " brainrot", 4, "success")
end

function Steal.AutoLoop()
	if Steal.Active and not Steal._loopRunning then
		Steal._loopRunning = true
		task.spawn(function()
			while Steal.Active do
				task.wait(Steal.Cooldown + 1)
				if not Steal.Active then break end

				local target = nil
				if Steal.BrainrotMode then
					target = Base.GetBestBrainrotTarget() or Base.GetBestTarget()
				else
					target = Base.GetBestTarget()
				end

				if target then
					if Steal.SmartEvade and target.ThreatLevel == "Extreme" then
						Safe.Notify("STEAL", "Skipping extreme threat: " .. target.OwnerName, 2, "warning")
					else
						Base.TeleportTo(target, 20)
						task.wait(0.6)
						Steal.TrySteal(target)
						task.wait(0.5)

						if Steal.AutoReturn then
							task.wait(Steal.ReturnDelay)
							Steal.TeleportToBase()
						end
					end
				end
			end
			Steal._loopRunning = false
		end)
	end
end

function Steal.SetMode(mode)
	Steal.Mode = mode
	if mode == "Aggressive" then
		Steal.Cooldown = 0.5
		Steal.AutoReturn = true
		Steal.SmartEvade = false
	elseif mode == "Nuclear" then
		Steal.Cooldown = 0.1
		Steal.AutoReturn = true
		Steal.BrainrotMode = true
		Steal.SmartEvade = false
	elseif mode == "Silent" then
		Steal.Cooldown = 5
		Steal.AutoReturn = false
		Steal.SmartEvade = true
	elseif mode == "Ghost" then
		Steal.Cooldown = 3
		Steal.AutoReturn = true
		Steal.SmartEvade = true
	else
		Steal.Cooldown = 1.5
		Steal.AutoReturn = true
		Steal.SmartEvade = true
	end
	Safe.Notify("STEAL", "Mode: " .. mode .. " | AutoReturn: " .. tostring(Steal.AutoReturn), 2, "info")
end

