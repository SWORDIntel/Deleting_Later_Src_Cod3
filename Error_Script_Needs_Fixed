			for _, obj in ipairs(getgc(true)) do
				if typeof(obj) == "Instance" and obj:IsA("ScreenGui") then
					if obj.Name:find("UNC") then
						pcall(function()
							obj.Name = Shield.GenerateName("GUI")
						end)
					end
				end
			end
		end
	end)
end

-- Metatable protection
function Shield.ProtectMetatable(obj)
	pcall(function()
		local mt = getrawmetatable and getrawmetatable(obj)
		if mt and setreadonly then
			setreadonly(mt, false)
			local oldIndex = mt.__index
			local oldNamecall = mt.__namecall
			
			mt.__index = function(self, key)
				if key == "Name" and Shield.ProtectedNames[self] then
					return Shield.ProtectedNames[self]
				end
				if oldIndex then
					return oldIndex(self, key)
				end
				return rawget(self, key)
			end
			
			if setreadonly then
				setreadonly(mt, true)
			end
		end
	end)
end

