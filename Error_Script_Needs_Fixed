function Steal.ScanRemotes()
	Steal.Remotes = {}

	local function scanFolder(folder)
		if not folder then return end
		for _, obj in ipairs(folder:GetDescendants()) do
			if obj and (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")) then
				local name = obj.Name:lower()
				local detected = false
				local score = 0
				for _, pattern in ipairs(Steal.Patterns) do
					if name:find(pattern) then
						detected = true
						score = score + 10
					end
				end
				if name:find("server") or name:find("request") or name:find("action") or name:find("event") then
					score = score + 5
				end
				if name:find("brainrot") or name:find("pet") or name:find("item") or name:find("loot") then
					score = score + 25
				end
				table.insert(Steal.Remotes, {
					Remote = obj,
					Detected = detected,
					Name = obj.Name,
					Score = score,
					Type = obj:IsA("RemoteEvent") and "Event" or "Function",
					LastUsed = 0,
					SuccessRate = 50
				})
			end
		end
	end

	scanFolder(ReplicatedStorage)
	scanFolder(Workspace)

	table.sort(Steal.Remotes, function(a, b)
		return a.Score > b.Score
	end)

	Safe.Notify("STEAL", #Steal.Remotes .. " remotes scanned", 3, "success")
	return Steal.Remotes
end

function Steal.FindBaseSafeZone()
	if Base.MyBase and Base.MyBase.Plot then
		local plot = Base.MyBase.Plot
		local part = plot:FindFirstChildWhichIsA("BasePart")
		if part then
			Steal.BaseSafeZone = part.Position + Vector3.new(0, 10, 0)
			return Steal.BaseSafeZone
		end
	end

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj and obj:IsA("BasePart") then
			local name = obj.Name:lower()
			if name:find("safe") or name:find("spawn") or name:find("home") or name:find("base") then
				local color = obj.Color
				if color.G > 0.5 and color.R < 0.5 then
					Steal.BaseSafeZone = obj.Position + Vector3.new(0, 5, 0)
					return Steal.BaseSafeZone
				end
			end
		end
	end

	return nil
end

