-- QUANTUM AIMBOT v5 (Silent + FOV + Smooth + Prediction + Shielded)
-- ═══════════════════════════════════════════════════════════════════════════════

local Aimbot = {}
Aimbot.Active = false
Aimbot.Target = nil
Aimbot.FOV = 150
Aimbot.Smoothness = 0.15
Aimbot.Prediction = 0.165
Aimbot.AimPart = "Head"
Aimbot.TeamCheck = true
Aimbot.WallCheck = false
Aimbot.ShowFOV = false
Aimbot.FOVCircle = nil
Aimbot.Stats = {Aims = 0, Locks = 0}
Aimbot.ShieldMode = true

function Aimbot.GetClosestPlayer()
	local closest = nil
	local closestDist = Aimbot.FOV
	local mousePos = UserInputService:GetMouseLocation()

	for _, player in ipairs(Players:GetPlayers()) do
		local skip = false
		if player == LP then skip = true end
		if not skip and Aimbot.TeamCheck and player.Team and LP.Team and player.Team == LP.Team then skip = true end
		if not skip and not player.Character then skip = true end

		if not skip then
			local aimPart = player.Character:FindFirstChild(Aimbot.AimPart)
			if not aimPart then skip = true end

			if not skip then
				local screenPos, onScreen = Camera:WorldToViewportPoint(aimPart.Position)
				if not onScreen then skip = true end

				if not skip then
					local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
					if dist < closestDist then
						closestDist = dist
						closest = player
					end
				end
			end
		end
	end

	return closest
end

function Aimbot.GetPredictedPosition(player)
	if not player or not player.Character then return nil end
	local aimPart = player.Character:FindFirstChild(Aimbot.AimPart)
	if not aimPart then return nil end

	local hrp = player.Character:FindFirstChild("HumanoidRootPart")
	if hrp then
		local velocity = hrp.Velocity
		-- Shield: clamp velocity to prevent extreme prediction
		if Aimbot.ShieldMode and velocity.Magnitude > 100 then
			velocity = velocity.Unit * 100
		end
		return aimPart.Position + (velocity * Aimbot.Prediction)
	end
	return aimPart.Position
end

function Aimbot.AimAt(position)
	if not position then return end
	Safe.Call(function()
		local currentCF = Camera.CFrame
		local targetDirection = (position - currentCF.Position).Unit
		local smoothFactor = 1 - Aimbot.Smoothness
		local newLook = currentCF.LookVector:Lerp(targetDirection, smoothFactor)
		Camera.CFrame = CFrame.new(currentCF.Position, currentCF.Position + newLook)
		Aimbot.Stats.Aims = Aimbot.Stats.Aims + 1
	end)
end

function Aimbot.Update()
	if not Aimbot.Active then return end

	if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
		-- Shield: throttle aimbot updates
		if Aimbot.ShieldMode and not Shield.CanProceed("AimbotUpdate", 60) then
			return
		end
		local target = Aimbot.GetClosestPlayer()
		if target then
			Aimbot.Target = target
			local pos = Aimbot.GetPredictedPosition(target)
			if pos then
				Aimbot.AimAt(pos)
				Aimbot.Stats.Locks = Aimbot.Stats.Locks + 1
			end
		end
	else
		Aimbot.Target = nil
	end
end

function Aimbot.Toggle()
	Aimbot.Active = not Aimbot.Active
	Safe.Notify("AIMBOT", Aimbot.Active and "ACTIVE | Hold RMB to aim" or "Disabled", 3, Aimbot.Active and "success" or "info")
end

Safe.Connect(RunService.RenderStepped, function()
	Aimbot.Update()
end)

