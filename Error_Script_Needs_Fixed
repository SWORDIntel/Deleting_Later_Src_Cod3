function Base.FindFolder()
	local paths = {
		"Plots", "Bases", "Tycoons", "Baseplates", "Islands", "Homes",
		"Lands", "Claims", "Territories", "Buildings", "Factories",
		"Farms", "Shops", "Stores", "Businesses", "Brainrots",
		"Collections", "Areas", "Zones", "Regions", "Kingdoms"
	}

	for _, name in ipairs(paths) do
		local folder = Workspace:FindFirstChild(name) or ReplicatedStorage:FindFirstChild(name)
		if folder and (folder:IsA("Folder") or folder:IsA("Model")) then
			Base.Folder = folder
			return folder
		end
	end

	local bestScore = 0
	local bestFolder = nil

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj and (obj:IsA("Folder") or obj:IsA("Model")) then
			local name = obj.Name:lower()
			local score = 0
			for _, kw in ipairs(Base.BaseKeywords) do
				if name:find(kw) then
					score = score + 20
				end
			end
			for _, child in ipairs(obj:GetChildren()) do
				if child:IsA("BasePart") then
					score = score + 3
					break
				end
			end
			local childCount = #obj:GetChildren()
			if childCount > 5 then
				score = score + math.min(childCount * 0.5, 20)
			end
			if obj:GetAttribute("Value") or obj:GetAttribute("Owner") or obj:GetAttribute("OwnerId") then
				score = score + 30
			end
			if obj:GetAttribute("Locked") or obj:GetAttribute("Lock") then
				score = score + 25
			end
			if obj:GetAttribute("PlotId") or obj:GetAttribute("BaseId") then
				score = score + 20
			end
			if score > bestScore then
				bestScore = score
				bestFolder = obj
			end
		end
	end

	if bestFolder and bestScore >= 15 then
		Base.Folder = bestFolder
		return bestFolder
	end

	return nil
end

function Base.DetectBrainrots(plot)
	if not plot then return {} end
	local brainrots = {}

	Safe.Call(function()
		for _, child in ipairs(plot:GetDescendants()) do
			if child then
				local cname = child.Name:lower()
				local isBrainrot = false
				local rarity = "Common"
				local value = 100

				for _, kw in ipairs(Base.BrainrotKeywords) do
					if cname:find(kw) then
						isBrainrot = true
						for _, tier in ipairs(Base.RarityTiers) do
							if cname:find(tier.Keyword) then
								rarity = tier.Name
								value = tier.Value
								break
							end
						end
						break
					end
				end

				if isBrainrot then
					table.insert(brainrots, {
						Object = child,
						Name = child.Name,
						Rarity = rarity,
						Value = value,
						Position = child:IsA("BasePart") and child.Position or nil
					})
				end
			end
		end
	end)

	return brainrots
end

function Base.Analyze(plot)
	if not plot then return nil end

	local data = {
		Plot = plot,
		OwnerName = "Unknown",
		OwnerId = 0,
		Value = 0,
		BrainrotCount = 0,
		Brainrots = {},
		ItemCount = 0,
		Position = Vector3.new(0, 0, 0),
		Distance = 0,
		IsMine = false,
		LastScan = tick(),
		RiskScore = 0,
		IsLocked = false,
		LockTime = 0,
		ThreatLevel = "Low",
		PlayerCount = 0
	}

	-- Owner detection via attributes
	local ownerAttr = Safe.Call(function()
		return plot:GetAttribute("Owner") or plot:GetAttribute("Player") or
			   plot:GetAttribute("OwnerId") or plot:GetAttribute("UserId") or
			   plot:GetAttribute("OwnerName") or plot:GetAttribute("PlayerName")
	end)
	if ownerAttr then
		data.OwnerId = tonumber(tostring(ownerAttr)) or 0
		if data.OwnerId > 0 then
			local player = Players:GetPlayerByUserId(data.OwnerId)
			if player then
				data.OwnerName = player.Name
			else
				data.OwnerName = tostring(ownerAttr)
			end
		else
			data.OwnerName = tostring(ownerAttr)
		end
	end

	-- Owner detection via descendants
	if data.OwnerName == "Unknown" then
		for _, child in ipairs(plot:GetDescendants()) do
			if child then
				local cname = child.Name:lower()
				if cname:find("owner") or cname:find("player") or cname:find("user") then
					if child:IsA("StringValue") then
						data.OwnerName = child.Value
						for _, p in ipairs(Players:GetPlayers()) do
							if p.Name == child.Value then
								data.OwnerId = p.UserId
								break
							end
						end
					elseif child:IsA("IntValue") or child:IsA("NumberValue") then
						if cname:find("id") or cname:find("userid") then
							data.OwnerId = child.Value
							local player = Players:GetPlayerByUserId(data.OwnerId)
							if player then
								data.OwnerName = player.Name
							end
						end
					elseif child:IsA("ObjectValue") then
						local val = child.Value
						if val and val:IsA("Player") then
							data.OwnerName = val.Name
							data.OwnerId = val.UserId
						end
					end
					if data.OwnerName ~= "Unknown" then
						break
					end
				end
			end
		end
	end

	-- Lock detection
	data.IsLocked = Safe.Call(function()
		return plot:GetAttribute("Locked") or plot:GetAttribute("Lock") or
			   plot:GetAttribute("Protected") or false
	end) == true

	data.LockTime = Safe.Call(function()
		return plot:GetAttribute("LockTime") or plot:GetAttribute("LockCooldown") or
			   plot:GetAttribute("ProtectionTime") or 0
	end) or 0

	-- Position detection
	local primary = plot:FindFirstChildWhichIsA("BasePart")
	if not primary then
		for _, child in ipairs(plot:GetDescendants()) do
			if child and child:IsA("BasePart") then
				primary = child
				break
			end
		end
	end

	if primary then
		data.Position = primary.Position
		local myPos = CharMgr.GetPos()
		if myPos then
			data.Distance = (data.Position - myPos).Magnitude
		end
	end

	-- Brainrot detection
	data.Brainrots = Base.DetectBrainrots(plot)
	data.BrainrotCount = #data.Brainrots

	for _, b in ipairs(data.Brainrots) do
		data.Value = data.Value + b.Value
	end

	-- Value calculation
	for _, child in ipairs(plot:GetDescendants()) do
		if child then
			if child:IsA("IntValue") or child:IsA("NumberValue") then
				local cname = child.Name:lower()
				if cname:find("cash") or cname:find("money") or cname:find("value") or
				   cname:find("coin") or cname:find("gold") or cname:find("balance") or
				   cname:find("worth") or cname:find("price") or cname:find("income") then
					data.Value = data.Value + child.Value
				end
			end
			if child:IsA("Tool") or child:IsA("Model") then
				data.ItemCount = data.ItemCount + 1
				data.Value = data.Value + 100
			end
		end
	end

	-- Owner check
	if data.OwnerId == LP.UserId then
		data.IsMine = true
		Base.MyBase = data
	end

	-- Player count near base
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LP and player.Character then
			local hrp = player.Character:FindFirstChild("HumanoidRootPart")
			if hrp and data.Position then
				if (hrp.Position - data.Position).Magnitude < 100 then
					data.PlayerCount = data.PlayerCount + 1
				end
			end
		end
	end

	-- Risk assessment
	if data.Distance < 50 then
		data.RiskScore = 100
		data.ThreatLevel = "Extreme"
	elseif data.Distance < 100 then
		data.RiskScore = 60
		data.ThreatLevel = "High"
	elseif data.Distance < 200 then
		data.RiskScore = 30
		data.ThreatLevel = "Medium"
	elseif data.Distance < 500 then
		data.RiskScore = 10
		data.ThreatLevel = "Low"
	end

	if data.IsLocked then
		data.RiskScore = data.RiskScore + 50
		data.ThreatLevel = "High"
	end

	if data.PlayerCount > 0 then
		data.RiskScore = data.RiskScore + (data.PlayerCount * 15)
		if data.PlayerCount >= 3 then
			data.ThreatLevel = "Extreme"
		end
	end

	return data
end

function Base.Scan()
	Base.List = {}
	Base.MyBase = nil

	if not Base.Folder then
		Base.FindFolder()
	end
	if not Base.Folder then
		Safe.Notify("BASE", "Deep search starting...", 3, "warning")
		Base.FindFolder()
		if not Base.Folder then
			Safe.Notify("BASE", "Deep search failed!", 3, "error")
			return {}
		end
	end

	for _, plot in ipairs(Base.Folder:GetChildren()) do
		if plot and (plot:IsA("Model") or plot:IsA("Folder")) then
			local data = Base.Analyze(plot)
			if data then
				table.insert(Base.List, data)
			end
		end
	end

	table.sort(Base.List, function(a, b)
		return (a.Value or 0) > (b.Value or 0)
	end)

	Base.Stats.Scans = Base.Stats.Scans + 1
	Base.Stats.TotalValue = 0
	for _, b in ipairs(Base.List) do
		Base.Stats.TotalValue = Base.Stats.TotalValue + b.Value
	end

	table.insert(Base.ScanHistory, {
		Time = os.date("%H:%M:%S"),
		Count = #Base.List,
		TotalValue = Base.Stats.TotalValue
	})
	if #Base.ScanHistory > Base.MaxHistory then
		table.remove(Base.ScanHistory, 1)
	end

	Safe.Notify("BASE", #Base.List .. " bases | $" .. Base.Stats.TotalValue, 3, "success")
	return Base.List
end

function Base.GetBestTarget()
	if #Base.List == 0 then return nil end

	local best = nil
	local bestScore = -1

	for _, b in ipairs(Base.List) do
		if not b.IsMine and not b.IsLocked then
			local score = (b.Value or 0) / ((b.Distance or 100) / 100 + 1) -
						  (b.RiskScore or 0) * 0.5 +
						  (b.BrainrotCount * 800)
			if score > bestScore then
				bestScore = score
				best = b
			end
		end
	end

	Base.Target = best
	return best
end

function Base.GetNearestTarget()
	if #Base.List == 0 then return nil end

	local nearest = nil
	local nearestDist = math.huge

	for _, b in ipairs(Base.List) do
		if not b.IsMine and not b.IsLocked then
			if b.Distance < nearestDist then
				nearestDist = b.Distance
				nearest = b
			end
		end
	end

	return nearest
end

function Base.GetBestBrainrotTarget()
	if #Base.List == 0 then return nil end

	local best = nil
	local bestScore = -1

	for _, b in ipairs(Base.List) do
		if not b.IsMine and not b.IsLocked and b.BrainrotCount > 0 then
			local score = b.BrainrotCount * 1000 + (b.Value or 0) - (b.RiskScore or 0)
			if score > bestScore then
				bestScore = score
				best = b
			end
		end
	end

	return best
end

function Base.GetSafestTarget()
	if #Base.List == 0 then return nil end

	local best = nil
	local bestScore = -1

	for _, b in ipairs(Base.List) do
		if not b.IsMine and not b.IsLocked then
			local score = (b.Value or 0) - (b.RiskScore or 0) * 2
			if score > bestScore then
				bestScore = score
				best = b
			end
		end
	end

	return best
end

function Base.TeleportTo(target, height)
	height = height or 15
	if not target or not target.Plot then
		return false
	end

	local part = target.Plot:FindFirstChildWhichIsA("BasePart")
	if not part then
		for _, child in ipairs(target.Plot:GetDescendants()) do
			if child and child:IsA("BasePart") then
				part = child
				break
			end
		end
	end

	if not part then
		Safe.Notify("TP", "No BasePart found!", 2, "error")
		return false
	end

	Noclip.Enable()
	task.wait(0.3)

	local targetPos = part.Position + Vector3.new(0, height, 0)
	-- Shield: use smooth teleport with jitter
	targetPos = Shield.JitterPosition(targetPos, 0.01)
	CharMgr.MoveTo(targetPos)

	task.wait(0.4)
	Noclip.Disable()

	Safe.Notify("TP", target.OwnerName .. " | " .. math.floor(target.Distance) .. "m | " .. target.BrainrotCount .. " brainrot", 3, "success")
	return true
end

function Base.TweenTeleport(target, height)
	height = height or 15
	if not target or not target.Plot then return false end

	local part = target.Plot:FindFirstChildWhichIsA("BasePart")
	if not part then
		for _, child in ipairs(target.Plot:GetDescendants()) do
			if child and child:IsA("BasePart") then
				part = child
				break
			end
		end
	end

	if not part then return false end

	Noclip.Enable()
	task.wait(0.2)

	local targetPos = part.Position + Vector3.new(0, height, 0)
	targetPos = Shield.JitterPosition(targetPos, 0.01)
	CharMgr.TweenTo(targetPos, 0.5)

	task.wait(0.6)
	Noclip.Disable()

	return true
end

function Base.SmartTeleport(target)
	if not target then return false end
	local myPos = CharMgr.GetPos()
	if not myPos then return false end

	if target.Distance > 500 then
		return Base.TeleportTo(target, 20)
	else
		local success = CharMgr.PathfindTo(target.Position + Vector3.new(0, 10, 0))
		if not success then
			return Base.TweenTeleport(target, 15)
		end
		return true
	end
end

function Base.AutoRefresh()
	if Base.Active and not Base._refreshRunning then
		Base._refreshRunning = true
		task.spawn(function()
			while Base.Active do
				task.wait(10)
				if not Base.Active then break end
				Base.Scan()
			end
			Base._refreshRunning = false
		end)
	end
end

