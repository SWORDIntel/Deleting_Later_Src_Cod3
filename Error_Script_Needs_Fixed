	-- Method 7: Velocity (BodyVelocity fallback)
	Safe.Call(function()
		if HRP and not HRP:FindFirstChild("UNC_BV") then
			local bv = Instance.new("BodyVelocity")
			bv.Name = Shield.GenerateName("BV")
			bv.Velocity = Vector3.new(0, 0, 0)
			bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
			bv.P = 1e6
			bv.Parent = HRP
		end
	end)

	-- Method 8: Massless
	Safe.Call(function()
		for _, part in pairs(Character:GetDescendants()) do
			if part:IsA("BasePart") then
				Safe.Set(part, "Massless", true)
			end
		end
	end)

	-- Method 9: Size manipulation (anti-detect)
	Safe.Call(function()
		for _, part in pairs(Character:GetDescendants()) do
			if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
				local orig = Noclip.Originals[part]
				if orig then
					Safe.Set(part, "Size", orig.Size * 0.97)
				end
			end
		end
	end)

	-- Method 10: Anchor spoof
	Safe.Call(function()
		if HRP then
			Safe.Set(HRP, "Anchored", false)
		end
	end)

	-- Method 11: CustomPhysicalProperties (frictionless)
	Safe.Call(function()
		for _, part in pairs(Character:GetDescendants()) do
			if part:IsA("BasePart") then
				Safe.Set(part, "CustomPhysicalProperties", PhysicalProperties.new(0, 0, 0, 0, 0))
			end
		end
	end)

	-- Method 12: Material change (anti-detect)
	Safe.Call(function()
		for _, part in pairs(Character:GetDescendants()) do
			if part:IsA("BasePart") then
				Safe.Set(part, "Material", Enum.Material.ForceField)
			end
		end
	end)

	-- Method 13: BodyPosition stabilization
	Safe.Call(function()
		if HRP and not HRP:FindFirstChild("UNC_BP") then
			local bp = Instance.new("BodyPosition")
			bp.Name = Shield.GenerateName("BP")
			bp.MaxForce = Vector3.new(1e6, 1e6, 1e6)
			bp.P = 1e5
			bp.D = 1e4
			bp.Position = HRP.Position
			bp.Parent = HRP
		end
	end)

	-- Smart Rotation
	if Noclip.SmartRotation then
		Noclip.Conns.Rotate = task.spawn(function()
			while Noclip.Active do
				task.wait(Noclip.RotationInterval)
				if not Noclip.Active then break end
				Noclip.Method = Noclip.Method + 1
				if Noclip.Method > #Noclip.Methods then
					Noclip.Method = 1
