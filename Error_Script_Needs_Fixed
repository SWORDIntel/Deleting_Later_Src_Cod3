-- QUANTUM SPEED & JUMP MODULE v5 (Undetectable + Smooth + Shielded)
-- ═══════════════════════════════════════════════════════════════════════════════

local SpeedMod = {}
SpeedMod.Active = false
SpeedMod.Speed = 80
SpeedMod.Conn = nil
SpeedMod.AntiDetectInterval = 3
SpeedMod.LastSpoof = 0
SpeedMod.ShieldJitter = true

function SpeedMod.Enable(speed)
	if SpeedMod.Active then return end
	SpeedMod.Active = true
	SpeedMod.Speed = speed or 80

	SpeedMod.Conn = RunService.Heartbeat:Connect(function()
		if not SpeedMod.Active or not Humanoid then return end
		-- Shield: throttle speed updates to prevent detection
		if Shield.CanProceed("SpeedUpdate", 20) then
			Safe.Call(function()
				local targetSpeed = SpeedMod.Speed
				-- Add micro jitter to prevent exact value detection
				if SpeedMod.ShieldJitter then
					targetSpeed = targetSpeed + (math.random() - 0.5) * 0.5
				end
				Humanoid.WalkSpeed = targetSpeed
			end)
		end
		local now = tick()
		if now - SpeedMod.LastSpoof > SpeedMod.AntiDetectInterval then
			Safe.Call(function()
				if Humanoid then
					Humanoid.WalkSpeed = 16
				end
			end)
			task.wait(0.05)
			Safe.Call(function()
				if Humanoid then
					Humanoid.WalkSpeed = SpeedMod.Speed
				end
			end)
			SpeedMod.LastSpoof = now
		end
	end)

	Safe.Notify("SPEED", "Active: " .. SpeedMod.Speed, 2, "success")
end

function SpeedMod.Disable()
	SpeedMod.Active = false
	if SpeedMod.Conn then
		Safe.Call(function()
			SpeedMod.Conn:Disconnect()
		end)
		SpeedMod.Conn = nil
	end
	if Humanoid then
		Safe.Set(Humanoid, "WalkSpeed", CharMgr.OriginalProps.WalkSpeed or 16)
	end
	Safe.Notify("SPEED", "Disabled", 2, "info")
end

function SpeedMod.SetSpeed(speed)
	SpeedMod.Speed = speed
	if SpeedMod.Active and Humanoid then
		Safe.Set(Humanoid, "WalkSpeed", speed)
	end
end

local JumpMod = {}
JumpMod.Active = false
JumpMod.Power = 100
JumpMod.Conn = nil

function JumpMod.Enable(power)
	if JumpMod.Active then return end
	JumpMod.Active = true
	JumpMod.Power = power or 100

	if Humanoid then
		Safe.Set(Humanoid, "JumpPower", JumpMod.Power)
		Safe.Set(Humanoid, "JumpHeight", 15)
	end

	JumpMod.Conn = RunService.Heartbeat:Connect(function()
		if not JumpMod.Active or not Humanoid then return end
		Safe.Call(function()
			if Humanoid.JumpPower ~= JumpMod.Power then
				Humanoid.JumpPower = JumpMod.Power
			end
		end)
	end)

	Safe.Notify("JUMP", "Active: " .. JumpMod.Power, 2, "success")
end

function JumpMod.Disable()
	JumpMod.Active = false
	if JumpMod.Conn then
		Safe.Call(function()
			JumpMod.Conn:Disconnect()
		end)
		JumpMod.Conn = nil
	end
	if Humanoid then
		Safe.Set(Humanoid, "JumpPower", CharMgr.OriginalProps.JumpPower or 50)
		Safe.Set(Humanoid, "JumpHeight", CharMgr.OriginalProps.JumpHeight or 7.2)
	end
	Safe.Notify("JUMP", "Disabled", 2, "info")
end

