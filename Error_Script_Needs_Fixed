	UI.CreateTabBtn("Brainrot", "R", "Brainrot")
	UI.CreateTabBtn("Visuals", "V", "ESP")
	UI.CreateTabBtn("Aimbot", "A", "Aimbot")
	UI.CreateTabBtn("Auto", "T", "Auto")
	UI.CreateTabBtn("Shield", "Y", "Shield")
	UI.CreateTabBtn("Settings", "G", "Settings")

	-- Shield: Safe tab content creation with pcall to prevent any single tab from breaking the UI
	local function safeFill(name, fillFunc, contentFunc)
		local ok, content = pcall(contentFunc, name)
		if ok and content then
			local ok2, err = pcall(function() fillFunc(content) end)
			if not ok2 then
				Safe.Log("WARN", "Tab '" .. name .. "' fill error: " .. tostring(err):sub(1, 100))
			end
		else
			Safe.Log("WARN", "Tab '" .. name .. "' content creation failed")
		end
	end

	safeFill("Main", UI.FillMain, UI.CreateTabContent)
	safeFill("Noclip", UI.FillNoclip, UI.CreateTabContent)
	safeFill("Movement", UI.FillMovement, UI.CreateTabContent)
	safeFill("Base", UI.FillBase, UI.CreateTabContent)
	safeFill("Steal", UI.FillSteal, UI.CreateTabContent)
	safeFill("Brainrot", UI.FillBrainrot, UI.CreateTabContent)
	safeFill("ESP", UI.FillESP, UI.CreateTabContent)
	safeFill("Aimbot", UI.FillAimbot, UI.CreateTabContent)
	safeFill("Auto", UI.FillAuto, UI.CreateTabContent)
	safeFill("Shield", UI.FillShield, UI.CreateTabContent)
	safeFill("Settings", UI.FillSettings, UI.CreateTabContent)
end

