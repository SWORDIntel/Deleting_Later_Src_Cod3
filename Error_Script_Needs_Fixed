	UI.Visible = true
	UI.Main.Visible = true
	UI.Main.Size = UDim2.new(0, 0, 0, 0)
	TweenService:Create(UI.Main, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, 800, 0, 560),
