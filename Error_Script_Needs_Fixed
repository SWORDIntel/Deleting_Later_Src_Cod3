function UI.SwitchTab(tabName)
	UI.CurrentTab = tabName
	for _, tab in ipairs(UI.Tabs) do
		local active = (tab.Name == tabName)
		TweenService:Create(tab.Button, TweenInfo.new(0.3, Enum.EasingStyle.Quart), {
			BackgroundColor3 = active and UI.Theme.Primary or UI.Theme.Surface,
			BackgroundTransparency = active and 0.1 or 0.55
		}):Play()
		tab.Icon.TextColor3 = active and UI.Theme.Text or UI.Theme.Dim
		tab.Text.TextColor3 = active and UI.Theme.Text or UI.Theme.Dim
		tab.Indicator.Visible = active
	end
	for name, content in pairs(UI) do
		if typeof(content) == "Instance" and content:IsA("ScrollingFrame") and name:find("Content$") then
			content.Visible = (name == tabName .. "Content")
		end
	end
end

